# Copy this file into the Environment field of OMV Compose (or save it as .env).
# Do not commit real credentials to GitHub.

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_APP_PASSWORD=
IMAP_FOLDER=INBOX
POLL_INTERVAL=300

# Home Assistant webhook URL, restricted to the LAN.
HA_WEBHOOK_URL=

# IrenYou: enable after configuring your credentials.
IREN_AUTOMATION_ENABLED=false
IREN_USERNAME=
IREN_PASSWORD=
IREN_LOGIN_URL=https://clienti.irenyou.gruppoiren.it/login
IREN_USERNAME_SELECTOR=
IREN_PASSWORD_SELECTOR=input[type="password"]
IREN_SUBMIT_SELECTOR=
IREN_BILLS_URL=https://clienti.irenyou.gruppoiren.it/area-riservata/spese
IREN_DOWNLOAD_SELECTOR=
IREN_DEBUG_SCREENSHOT=false
IREN_RETRY_SECONDS=21600

# Gmail tests: off (normal), scan (read-only diagnostics), process (one selected IMAP UID).
TEST_MODE=off
TEST_PROVIDER=all
TEST_UID=
TEST_FORCE_REPROCESS=false
