# Copy to .env and fill locally on OMV. Never commit .env.
TZ=Europe/Rome

# Gmail IMAP
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_APP_PASSWORD=
IMAP_FOLDER=INBOX

# Home Assistant webhook URL, reachable from this Docker host/network
HA_WEBHOOK_URL=

# IrenYou credentials: keep empty until browser automation is configured
IREN_USERNAME=
IREN_PASSWORD=

# Poll interval in seconds
POLL_INTERVAL=300

# Do not enable Iren browser workflow until selectors/login are verified
IREN_AUTOMATION_ENABLED=false
